+/// How often this platform's ln, exp and ln_1p differ from the libm
+/// crate's, over arguments of the size garch feeds them.
+#[test]
+#[ignore = "study 549"]
+fn study549_function_agreement() {
+    let mut s = 549u64;
+    let n = 10_000_000;
+    let (mut dl, mut de, mut d1, mut ml, mut me, mut m1) = (0u64, 0u64, 0u64, 0u64, 0u64, 0u64);
+    for _ in 0..n {
+        let u = (lcg(&mut s) + 1.0) / 2.0; // [0, 1)
+        let x = 10f64.powf(-3.0 + 6.0 * u); // ln of a variance, 1e-3..1e3
+        let y = -20.0 + 40.0 * u; // exp of a log variance
+        let z = 1e-3 + 50.0 * u; // ln_1p(z²/ν), the t's density
+        let (a, b, c) = (ulps(x.ln(), libm::log(x)), ulps(y.exp(), libm::exp(y)), ulps(z.ln_1p(), libm::log1p(z)));
+        dl += u64::from(a > 0);
+        de += u64::from(b > 0);
+        d1 += u64::from(c > 0);
+        ml = ml.max(a);
+        me = me.max(b);
+        m1 = m1.max(c);
+    }
+    println!("ln differs {dl}/{n} (max {ml} ulp); exp {de}/{n} (max {me}); ln_1p {d1}/{n} (max {m1})");
+}
